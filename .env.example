DATABASE_URL=postgresql+psycopg://raton:raton@db:5432/raton
GLOBAL_QUOTA_BYTES=107374182400
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Pricing/max output known for: claude-haiku-4-5, claude-haiku-5-5, claude-sonnet-5(-5), claude-opus-*, claude-fable-* (app/services/llm_usage.py)
ANTHROPIC_MODEL=claude-sonnet-5
# Embeddings of the video notes (cross-video chat search), from https://dash.voyageai.com/
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
RERANK_MODEL=rerank-2.5
# Interface the app port is published on. 127.0.0.1 = this machine only; 0.0.0.0 = whole LAN (no authentication!).
APP_BIND=127.0.0.1
# Behind a reverse proxy that rewrites Host: public host(s) allowed for write requests, comma-separated (optional).
APP_TRUSTED_ORIGINS=
# Host folder holding the downloaded media, mounted on /media/youtube in the container (optional).
# Default: ./.local/media/YouTube. `make up` reads it from this file (a MEDIA_HOST_ROOT=/path in the shell
# environment takes precedence); scripts/uninstall.sh also reads it from .env.
# MEDIA_HOST_ROOT=
# Password of the bundled PostgreSQL role. Read only when the database volume is first created
# (changing it afterwards needs `ALTER ROLE` or a fresh volume). URL-safe characters only: it is embedded in DATABASE_URL.
# POSTGRES_PASSWORD=raton
